{
  "services": {
    "web": { "root": "web" },
    "server": {
      "root": "server",
      "entrypoint": "src/app.ts"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "git": { "deploymentEnabled": { "main": false } }
}
